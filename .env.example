# ==========================================
# BIT MESRA PLACEMENT PORTAL CREDENTIALS
# ==========================================
PORTAL_URL=https://tp.bitmesra.co.in
LOGIN_ID=your_roll_number_or_login_id
PASSWORD=your_portal_password

# ==========================================
# ELIGIBILITY & FILTER PREFERENCES
# ==========================================
# Your graduation year (e.g. 2025, 2026, 2027)
GRADUATION_YEAR=2026

# Filter types to watch (comma separated)
# Options: 2M, 3M, 6M, FTE
WATCH_ROLES=2M,3M,6M,FTE

# ==========================================
# NTFY PHONE NOTIFICATION SETTINGS
# ==========================================
# Pick any unique private topic name for your phone!
# Open ntfy app -> tap + -> subscribe to this exact topic name:
NTFY_TOPIC=bitmesra-jobs-alerts-private

# Interval in minutes for the background loop (if running server.js)
CHECK_INTERVAL_MINUTES=10
